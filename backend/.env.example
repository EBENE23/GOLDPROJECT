# Copiez ce fichier en ".env" puis remplissez vos propres valeurs.
# Ne jamais commiter le fichier ".env" réel (il est ignoré par Git).

PORT=3000

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=smartcitywaste
DB_PORT=3306

# Générez une valeur aléatoire, par exemple :
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=remplacez_par_une_longue_valeur_aleatoire
JWT_EXPIRES_IN=1d

# Règles métier (facultatif, valeurs par défaut dans le code si absentes)
MAX_MISSIONS_ACTIVES=5
MAX_AGENTS_PAR_ZONE=5
ZONE_MORTE_CM=20

# MQTT (Mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_TOPIC=smartcitywaste/bacs/+/mesure

# Origines autorisées en production, séparées par des virgules.
# Laissé vide en développement (toutes les origines sont acceptées).
CORS_ORIGINS=
